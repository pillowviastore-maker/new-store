<ul class="ltp" {{ block.shopify_attributes }}>
  {%- for i in (1..3) -%}
    {%- liquid
      assign ik = 'icon' | append: i
      assign tk = 'text' | append: i
    -%}
    <li><span class="ltp-ico" aria-hidden="true">{{ block.settings[ik] }}</span><span>{{ block.settings[tk] }}</span></li>
  {%- endfor -%}
</ul>
<style>
  .ltp { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; margin: 2px 0 6px; padding: 0; list-style: none; text-align: center; font-family: var(--font-body--family); font-size: 13px; color: #4B2834; }
  .ltp li { display: grid; justify-items: center; gap: 4px; }
  .ltp-ico { display: inline-flex; align-items: center; justify-content: center; width: 40px; height: 40px; border-radius: 50%; background: #FBEFEE; font-size: 20px; }
</style>
{% schema %}
{
  "name": "Belt: 3 benefits",
  "tag": null,
  "settings": [
    { "type": "text", "id": "icon1", "label": "Icon 1", "default": "❤️‍🩹" },
    { "type": "text", "id": "text1", "label": "Text 1", "default": "Soothes cramps" },
    { "type": "text", "id": "icon2", "label": "Icon 2", "default": "💆‍♀️" },
    { "type": "text", "id": "text2", "label": "Text 2", "default": "Relaxes muscles" },
    { "type": "text", "id": "icon3", "label": "Icon 3", "default": "☁️" },
    { "type": "text", "id": "text3", "label": "Text 3", "default": "Eases bloating" }
  ],
  "presets": [{ "name": "Belt: 3 benefits" }]
}
{% endschema %}
