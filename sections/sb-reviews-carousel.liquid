{%- liquid
  assign reviews_product = section.settings.product | default: product | default: all_products['sculpt-brief']
  assign data = reviews_product.metafields.judgeme.review_widget_data.value
  assign rating = reviews_product.metafields.reviews.rating.value
  assign rating_count = reviews_product.metafields.reviews.rating_count
  assign photo_count = 0
  for review in data.photo_gallery
    assign photo_count = photo_count | plus: 1
  endfor
-%}

{%- if data != blank -%}
  <div class="sbrc">
    <button type="button" class="sbrc-summary" data-sbrc-open aria-haspopup="dialog">
      <span class="sbrc-summary-score">{{ rating.rating | round: 1 | default: '5.0' }}</span>
      <span class="sbrc-summary-main">
        <span class="sbrc-summary-stars" aria-hidden="true">&#9733;&#9733;&#9733;&#9733;&#9733;</span>
        <span class="sbrc-summary-title">{{ section.settings.title }}</span>
        <span class="sbrc-summary-sub">Based on {{ rating_count }} reviews{% if photo_count > 0 %} · {{ photo_count }} with photos{% endif %}</span>
      </span>
      <span class="sbrc-summary-cta">Read reviews <span aria-hidden="true">&rsaquo;</span></span>
    </button>

    <dialog class="sbrc-dialog" data-sbrc-dialog aria-labelledby="sbrc-dialog-title-{{ section.id }}">
      <div class="sbrc-dialog-head">
        <div>
          <p class="sbrc-dialog-title" id="sbrc-dialog-title-{{ section.id }}">{{ section.settings.title }}</p>
          <p class="sbrc-dialog-sub"><span aria-hidden="true">&#9733;&#9733;&#9733;&#9733;&#9733;</span> {{ rating.rating | round: 1 }}/5 · {{ rating_count }} reviews</p>
        </div>
        <button type="button" class="sbrc-dialog-close" data-sbrc-close aria-label="Close reviews">&times;</button>
      </div>
      <div class="sbrc-list" data-sbrc-list></div>
      <template data-sbrc-template>
        {%- assign shown = 0 -%}
        {%- for review in data.photo_gallery -%}
          {%- assign review_text = review.body_html | strip_html | strip -%}
          {%- if shown < section.settings.limit and review_text.size > 12 and review_text != 'Sculpt Brief' -%}
            {%- render 'sb-review-card', review: review, show_source: section.settings.show_source -%}
            {%- assign shown = shown | plus: 1 -%}
          {%- endif -%}
        {%- endfor -%}
        {%- for review in data.reviews -%}
          {%- assign review_text = review.body_html | strip_html | strip -%}
          {%- if shown < section.settings.limit and review.pictures_urls.size == 0 and review_text.size > 12 -%}
            {%- render 'sb-review-card', review: review, show_source: section.settings.show_source -%}
            {%- assign shown = shown | plus: 1 -%}
          {%- endif -%}
        {%- endfor -%}
      </template>
    </dialog>
  </div>

  <style>
    .sbrc { max-width: 720px; margin: 0 auto; padding: 28px 16px; font-family: var(--font-body--family); }
    .sbrc-summary { display: flex; align-items: center; gap: 14px; width: 100%; padding: 16px 18px; border: 1.5px solid #F0DCE6; border-radius: 16px; background: #FBF3F7; color: #1A1A1A; font: inherit; text-align: left; cursor: pointer; transition: border-color .2s, box-shadow .2s, transform .15s; }
    .sbrc-summary:hover { border-color: #A3426D; box-shadow: 0 10px 24px rgba(163, 66, 109, .12); transform: translateY(-1px); }
    .sbrc-summary:focus-visible { outline: 3px solid #A3426D; outline-offset: 3px; }
    .sbrc-summary-score { flex: 0 0 auto; font-family: var(--font-heading--family); font-size: 40px; font-weight: 700; line-height: 1; color: #A3426D; }
    .sbrc-summary-main { display: flex; flex-direction: column; gap: 2px; flex: 1; min-width: 0; }
    .sbrc-summary-stars { color: #F5A623; font-size: 15px; letter-spacing: 2px; }
    .sbrc-summary-title { font-size: 16px; font-weight: 800; }
    .sbrc-summary-sub { font-size: 12.5px; color: #6F5F66; }
    .sbrc-summary-cta { flex: 0 0 auto; padding: 10px 14px; border-radius: 10px; background: #A3426D; color: #fff; font-size: 13.5px; font-weight: 800; white-space: nowrap; }
    .sbrc-dialog { width: min(100vw, 640px); max-width: 100vw; max-height: 88vh; margin: auto auto 0; padding: 0; border: 0; border-radius: 20px 20px 0 0; background: #fff; color: #1A1A1A; font-family: var(--font-body--family); box-shadow: 0 -12px 40px rgba(42, 26, 35, .25); overflow: hidden; }
    .sbrc-dialog[open] { display: flex; flex-direction: column; animation: sbrc-up .3s cubic-bezier(.2, 1, .3, 1); }
    .sbrc-dialog::backdrop { background: rgba(42, 26, 35, .5); }
    @keyframes sbrc-up { from { transform: translateY(40px); opacity: 0; } to { transform: none; opacity: 1; } }
    @media (min-width: 750px) { .sbrc-dialog { margin: auto; border-radius: 20px; max-height: 84vh; } }
    .sbrc-dialog-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 16px 18px 12px; border-bottom: 1px solid #F0DCE6; }
    .sbrc-dialog-title { margin: 0; font-family: var(--font-heading--family); font-size: 24px; font-weight: 700; line-height: 1.1; }
    .sbrc-dialog-sub { margin: 4px 0 0; font-size: 13px; color: #4A3B42; }
    .sbrc-dialog-sub span { color: #F5A623; letter-spacing: 1px; }
    .sbrc-dialog-close { flex: 0 0 auto; width: 38px; height: 38px; border: 0; border-radius: 50%; background: #FBF3F7; font-size: 24px; line-height: 1; color: #4A3B42; cursor: pointer; }
    .sbrc-list { overflow-y: auto; -webkit-overflow-scrolling: touch; padding: 6px 18px 22px; overscroll-behavior: contain; }
    .sbrc-card { display: flex; gap: 12px; align-items: flex-start; padding: 14px 0; border-bottom: 1px solid #F3E7ED; }
    .sbrc-card:last-child { border-bottom: 0; }
    .sbrc-thumb { flex: 0 0 64px; width: 64px; height: 64px; padding: 0; border: 0; border-radius: 10px; overflow: hidden; background: #f3eef1; cursor: zoom-in; transition: width .25s, height .25s, flex-basis .25s; }
    .sbrc-thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .sbrc-card.is-open { flex-direction: column; }
    .sbrc-card.is-open .sbrc-thumb { flex-basis: auto; width: 100%; height: auto; cursor: zoom-out; }
    .sbrc-card.is-open .sbrc-thumb img { height: auto; max-height: 60vh; object-fit: contain; }
    .sbrc-body { display: flex; flex-direction: column; gap: 4px; flex: 1; min-width: 0; }
    .sbrc-stars { color: #F5A623; font-size: 13px; letter-spacing: 1px; }
    .sbrc-star-off { color: #E2D7DD; }
    .sbrc-text { font-size: 14px; color: #444; line-height: 1.5; margin: 0; }
    .sbrc-text p { margin: 0; }
    .sbrc-meta { display: flex; align-items: center; flex-wrap: wrap; gap: 6px; font-size: 12.5px; font-weight: 700; color: #1A1A1A; }
    .sbrc-source { font-size: 10.5px; font-weight: 600; color: #6f5f66; background: #F7EDF2; padding: 2px 7px; border-radius: 10px; }
    @media (max-width: 480px) {
      .sbrc-summary { flex-wrap: wrap; }
      .sbrc-summary-cta { flex-basis: 100%; text-align: center; }
    }
    @media (prefers-reduced-motion: reduce) { .sbrc-dialog[open] { animation: none; } }
  </style>

  <script>
    (function () {
      var root = document.currentScript.previousElementSibling.previousElementSibling;
      var dialog = root && root.querySelector('[data-sbrc-dialog]');
      if (!dialog || typeof dialog.showModal !== 'function') return;
      var list = dialog.querySelector('[data-sbrc-list]');
      var template = dialog.querySelector('[data-sbrc-template]');
      // Reviews and their photos load only when the widget is opened.
      root.querySelector('[data-sbrc-open]').addEventListener('click', function () {
        if (!list.children.length) list.appendChild(template.content.cloneNode(true));
        dialog.showModal();
        list.scrollTop = 0;
      });
      dialog.addEventListener('click', function (e) {
        if (e.target === dialog || e.target.closest('[data-sbrc-close]')) { dialog.close(); return; }
        var thumb = e.target.closest('[data-sbrc-thumb]');
        if (!thumb) return;
        var card = thumb.closest('.sbrc-card');
        var img = thumb.querySelector('img');
        if (img.dataset.full && img.src !== img.dataset.full) img.src = img.dataset.full;
        card.classList.toggle('is-open');
      });
    })();
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Sculpt: reviews widget",
  "tag": "section",
  "class": "sb-section",
  "settings": [
    { "type": "product", "id": "product", "label": "Product", "info": "Defaults to the current product." },
    { "type": "text", "id": "title", "label": "Heading", "default": "What customers are saying" },
    { "type": "range", "id": "limit", "label": "Reviews to show", "min": 4, "max": 60, "step": 1, "default": 30 },
    { "type": "checkbox", "id": "show_source", "label": "Label imported reviews", "default": true, "info": "Shows a small label on reviews Judge.me marks as collected from another provider." }
  ],
  "presets": [{ "name": "Sculpt: reviews widget", "category": "Sculpt" }]
}
{% endschema %}
