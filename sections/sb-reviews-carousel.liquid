{%- liquid
  assign reviews_product = section.settings.product | default: product | default: all_products['sculpt-brief']
  assign data = reviews_product.metafields.judgeme.review_widget_data.value
  assign rating = reviews_product.metafields.reviews.rating.value
  assign rating_count = reviews_product.metafields.reviews.rating_count
-%}

{%- if data != blank -%}
  <div class="sbrc">
    <div class="sbrc-head">
      {%- if rating != blank -%}
        <div class="sbrc-rating">&#9733;&#9733;&#9733;&#9733;&#9733; <span>{{ rating.rating | round: 1 }}/5 · {{ rating_count }} reviews</span></div>
      {%- endif -%}
      <h2 class="sbrc-title">{{ section.settings.title }}</h2>
    </div>

    <div class="sbrc-viewport">
      <button type="button" class="sbrc-arrow sbrc-arrow--prev" data-sbrc-prev aria-label="Previous reviews">&#8249;</button>
      <div class="sbrc-track" data-sbrc-track>
        {%- assign shown = 0 -%}
        {%- for review in data.photo_gallery -%}
          {%- if shown < section.settings.limit -%}
            {%- render 'sb-review-card', review: review, show_source: section.settings.show_source -%}
            {%- assign shown = shown | plus: 1 -%}
          {%- endif -%}
        {%- endfor -%}
        {%- for review in data.reviews -%}
          {%- if shown < section.settings.limit and review.pictures_urls.size == 0 -%}
            {%- render 'sb-review-card', review: review, show_source: section.settings.show_source -%}
            {%- assign shown = shown | plus: 1 -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
      <button type="button" class="sbrc-arrow sbrc-arrow--next" data-sbrc-next aria-label="Next reviews">&#8250;</button>
    </div>
  </div>

  <style>
    .sbrc { padding: 40px 0 44px; max-width: 1160px; margin: 0 auto; font-family: var(--font-body--family); }
    .sbrc-head { padding: 0 16px; text-align: center; margin: 0 0 22px; }
    .sbrc-rating { color: #F5A623; font-size: 17px; letter-spacing: 2px; margin: 0 0 6px; }
    .sbrc-rating span { color: #333; font-size: 14px; font-weight: 600; letter-spacing: 0; margin-left: 6px; }
    .sbrc-title { font-size: 30px; font-weight: 800; color: #1A1A1A; margin: 0; line-height: 1.15; }
    .sbrc-viewport { position: relative; }
    .sbrc-track { display: flex; gap: 14px; overflow-x: auto; scroll-snap-type: x mandatory; scroll-padding: 0 16px; padding: 4px 16px 8px; scrollbar-width: none; -webkit-overflow-scrolling: touch; }
    .sbrc-track::-webkit-scrollbar { display: none; }
    .sbrc-card { flex: 0 0 78%; scroll-snap-align: start; background: #fff; border: 1.5px solid #F0DCE6; border-radius: 14px; overflow: hidden; display: flex; flex-direction: column; }
    .sbrc-img { aspect-ratio: 1 / 1; background: #f3eef1; }
    .sbrc-img img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .sbrc-body { padding: 14px; display: flex; flex-direction: column; gap: 6px; flex: 1; }
    .sbrc-stars { color: #F5A623; font-size: 14px; letter-spacing: 1px; }
    .sbrc-star-off { color: #E2D7DD; }
    .sbrc-text { font-size: 14px; color: #444; line-height: 1.5; margin: 0; display: -webkit-box; -webkit-line-clamp: 5; -webkit-box-orient: vertical; overflow: hidden; }
    .sbrc-text p { margin: 0; }
    .sbrc-meta { margin-top: auto; display: flex; align-items: center; flex-wrap: wrap; gap: 6px; font-size: 13px; font-weight: 700; color: #1A1A1A; }
    .sbrc-source { font-size: 10.5px; font-weight: 600; color: #8a7780; background: #F7EDF2; padding: 2px 7px; border-radius: 10px; }
    .sbrc-arrow { display: none; position: absolute; top: 50%; transform: translateY(-50%); z-index: 2; width: 42px; height: 42px; border-radius: 50%; border: 1.5px solid #B5557F; background: #fff; color: #B5557F; font-size: 22px; line-height: 1; cursor: pointer; box-shadow: 0 4px 14px rgba(0,0,0,.08); }
    .sbrc-arrow--prev { left: 4px; }
    .sbrc-arrow--next { right: 4px; }
    @media (min-width: 560px) { .sbrc-card { flex-basis: 44%; } }
    @media (min-width: 980px) {
      .sbrc-card { flex-basis: calc((100% - 3 * 14px) / 4); }
      .sbrc-track { padding: 4px 56px 8px; scroll-padding: 0 56px; }
      .sbrc-arrow { display: block; }
    }
  </style>

  <script>
    (function () {
      var root = document.currentScript.previousElementSibling.previousElementSibling;
      var track = root && root.querySelector('[data-sbrc-track]');
      if (!track) return;
      function step() { var card = track.firstElementChild; return card ? card.getBoundingClientRect().width + 14 : 300; }
      root.querySelector('[data-sbrc-prev]').addEventListener('click', function () { track.scrollBy({ left: -step(), behavior: 'smooth' }); });
      root.querySelector('[data-sbrc-next]').addEventListener('click', function () { track.scrollBy({ left: step(), behavior: 'smooth' }); });
    })();
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Sculpt: reviews carousel",
  "tag": "section",
  "class": "sb-section",
  "settings": [
    { "type": "product", "id": "product", "label": "Product", "info": "Defaults to the current product." },
    { "type": "text", "id": "title", "label": "Heading", "default": "What customers are saying" },
    { "type": "range", "id": "limit", "label": "Reviews to show", "min": 4, "max": 15, "step": 1, "default": 12 },
    { "type": "checkbox", "id": "show_source", "label": "Label imported reviews", "default": true, "info": "Shows a small label on reviews Judge.me marks as collected from another provider." }
  ],
  "presets": [{ "name": "Sculpt: reviews carousel", "category": "Sculpt" }]
}
{% endschema %}
