<style>

.lt-wall-section {
  background: #ffffff;
  padding: 58px 14px;
  font-family: inherit;
}

.lt-wall-container {
  max-width: 1150px;
  margin: 0 auto;
  text-align: center;
}

/* EYEBROW */

.lt-wall-eyebrow {
  color: #EFC7C4;
  text-transform: uppercase;
  letter-spacing: .16em;
  font-size: 12px;
  font-weight: 800;
  margin: 0 0 10px;
}

/* TITLE */

.lt-wall-container h2 {
  color: #4B2834;
  font-size: 38px;
  line-height: 1.1;
  font-weight: 900;
  margin: 0 0 12px;
}

.lt-wall-container h2 span {
  color: #EFC7C4;
}

/* SUBTITLE */

.lt-wall-subtitle {
  color: #6F5B60;
  font-size: 16px;
  line-height: 1.45;
  margin: 0 auto 32px;
}

/* IMAGE GRID */

.lt-wall-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 10px;
}

.lt-wall-grid img {
  width: 100%;
  height: 260px;
  object-fit: cover;
  border-radius: 18px;
  display: block;
}

.lt-wall-grid img:nth-child(3n) {
  height: 330px;
}

.lt-wall-grid img:nth-child(4n) {
  height: 220px;
}

/* CTA */

.lt-cta-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: fit-content;
  margin: 32px auto 0;
  padding: 18px 32px;

  background: #EFC7C4;
  color: #FAF5EF !important;

  text-decoration: none;
  font-size: 16px;
  font-weight: 800;

  border-radius: 999px;

  transition: all .2s ease;

  box-shadow: 0 8px 24px rgba(75, 40, 52, .18);
}

.lt-cta-btn:hover {
  transform: translateY(-2px);
  background: #CFA8A4;
  color: #4B2834 !important;
}

/* MOBILE */

@media(max-width: 768px) {

  .lt-wall-section {
    padding: 42px 10px;
  }

  .lt-wall-container h2 {
    font-size: 28px;
  }

  .lt-wall-subtitle {
    font-size: 14px;
    margin-bottom: 24px;
  }

  .lt-wall-grid {
    grid-template-columns: repeat(2, 1fr);
    gap: 8px;
  }

  .lt-wall-grid img {
    height: 210px;
    border-radius: 14px;
  }

  .lt-wall-grid img:nth-child(3n) {
    height: 250px;
  }

  .lt-wall-grid img:nth-child(4n) {
    height: 180px;
  }

  .lt-cta-btn {
    width: 100%;
    max-width: 340px;
    padding: 16px 24px;
    font-size: 15px;
    margin-top: 24px;
  }

}

</style>

