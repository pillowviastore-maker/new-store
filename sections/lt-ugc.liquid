  .lt-video-card {
    flex-basis: 78vw;
    max-width: 290px;
  }

  .lt-play-button {
    width: 64px;
    height: 64px;
    font-size: 30px;
  }

  .lt-video-overlay {
    left: 9px;
    right: 9px;
    bottom: 9px;

    padding: 10px;

    border-radius: 14px;
  }

  .lt-video-overlay p {
    font-size: 12px;
  }

  .lt-video-overlay strong {
    font-size: 10px;
  }

}

</style>


<script>

(function(){

  function initLtVideos(){

    document
      .querySelectorAll('.lt-video-card')
      .forEach(function(card){

        if(card.dataset.ltVideoReady === 'true') return;

        card.dataset.ltVideoReady = 'true';

        var video = card.querySelector('video');

        if(!video) return;


        card.addEventListener('click', async function(){

          document
            .querySelectorAll('.lt-video-card video')
            .forEach(function(v){

              if(v !== video){

                v.pause();
                v.currentTime = 0;
                v.muted = true;

                var c = v.closest('.lt-video-card');

                if(c){
                  c.classList.remove('playing');
                }

              }

            });


          video.muted = false;
          video.volume = 1;

          card.classList.add('playing');


          try {
            await video.play();
          } catch(e) {}


          try {

            if(video.requestFullscreen) {

              await video.requestFullscreen();

            } else if(video.webkitEnterFullscreen) {

              video.webkitEnterFullscreen();

            } else if(video.webkitRequestFullscreen) {

              await video.webkitRequestFullscreen();

            }

          } catch(e) {}

        });


        video.addEventListener('pause', function(){

          card.classList.remove('playing');

        });


        video.addEventListener('ended', function(){

          card.classList.remove('playing');

          video.currentTime = 0;
          video.muted = true;

        });

      });

  }


  document.addEventListener(
    'DOMContentLoaded',
    initLtVideos
  );

  document.addEventListener(
    'shopify:section:load',
    initLtVideos
  );

  window.addEventListener(
    'load',
    initLtVideos
  );


  function resetLtVideos(){

    document
      .querySelectorAll('.lt-video-card video')
      .forEach(function(video){

        video.pause();
        video.currentTime = 0;
        video.muted = true;

        var card = video.closest('.lt-video-card');

        if(card){
          card.classList.remove('playing');
        }

      });

  }


  document.addEventListener(
    'fullscreenchange',
    function(){

      if(!document.fullscreenElement){
        resetLtVideos();
      }

    }
  );


  document.addEventListener(
    'webkitfullscreenchange',
    function(){

      if(!document.webkitFullscreenElement){
        resetLtVideos();
      }

    }
  );

})();

</script>

