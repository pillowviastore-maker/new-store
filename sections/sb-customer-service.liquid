<style>
  .sbcs { background:#FBF2F7; padding:44px 20px; font-family:var(--font-body--family); }
  .sbcs-inner { max-width:960px; margin:0 auto; text-align:center; }
  .sbcs-eyebrow { font-size:12px; letter-spacing:2px; text-transform:uppercase; color:#B5557F; font-weight:700; margin:0 0 8px; }
  .sbcs-title {  font-size:30px; line-height:38px; color:#2A1A23; margin:0 0 10px; font-weight:400; }
  .sbcs-sub { font-size:15px; line-height:24px; color:#555; margin:0 auto 22px; max-width:520px; }
  .sbcs-hours { display:inline-flex; align-items:center; gap:8px; font-size:14px; color:#2A1A23; font-weight:600; background:#fff; border:1px solid #EBD3E0; border-radius:999px; padding:9px 18px; margin:0 0 18px; }
  .sbcs-hours svg { width:16px; height:16px; flex-shrink:0; }
  .sbcs-mail { display:block; margin:0 0 6px; }
  .sbcs-mail a { font-size:19px; font-weight:700; color:#B5557F; text-decoration:none; }
  .sbcs-reply { font-size:13px; color:#888; margin:0 0 30px; font-style:italic; }
  .sbcs-badges { display:flex; flex-wrap:wrap; justify-content:center; gap:14px 30px; border-top:1px solid #EBD3E0; padding-top:26px; }
  .sbcs-badge { display:inline-flex; align-items:center; gap:8px; font-size:13.5px; color:#2A1A23; font-weight:600; }
  .sbcs-badge svg { width:18px; height:18px; color:#B5557F; flex-shrink:0; }
  @media (max-width:600px){
    .sbcs-title{ font-size:25px; line-height:32px; }
    .sbcs-badges{ gap:14px 20px; }
    .sbcs-badge{ font-size:13px; }
  }
</style>

<div class="sbcs">
  <div class="sbcs-inner">

    <p class="sbcs-eyebrow">We're here for you</p>
    <h2 class="sbcs-title">Customer Service</h2>
    <p class="sbcs-sub">Real people, not bots. If you have a question before or after your order, we'll help you personally &mdash; no scripts, no runaround.</p>

    <div class="sbcs-hours">
      <svg viewBox="0 0 24 24" fill="none" stroke="#B5557F" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
      Available Monday to Sunday &middot; 9:00 AM &ndash; 7:00 PM
    </div>

    <div class="sbcs-mail">
      <a href="mailto:{{ shop.email }}">{{ shop.email }}</a>
    </div>
    <p class="sbcs-reply">We reply to every message within 24 hours.</p>

    <div class="sbcs-badges">
      <span class="sbcs-badge">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M9 12l2 2 4-4"/></svg>
        90-Day Money-Back Guarantee
      </span>
      <span class="sbcs-badge">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a15 15 0 0 1 0 18M12 3a15 15 0 0 0 0 18"/></svg>
        Worldwide Shipping
      </span>
      <span class="sbcs-badge">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="10" width="16" height="10" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg>
        Secure Checkout
      </span>
    </div>

  </div>
</div>

{% schema %}
{
  "name": "Sculpt: support",
  "tag": "section",
  "class": "sb-section",
  "settings": [],
  "presets": [
    {
      "name": "Sculpt: support",
      "category": "Sculpt"
    }
  ]
}
{% endschema %}
