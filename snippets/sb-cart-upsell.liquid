{%- doc -%}
  Suggests the next Sculpt Brief bundle in the cart and adds the missing items in one tap.
  Tier sizes and percentages must match the automatic discounts in Shopify.
{%- enddoc -%}
{%- liquid
  assign handle = 'sculpt-brief'
  assign qty = 0
  assign last_variant_id = blank
  assign last_bundle = ''
  for item in cart.items
    if item.product.handle == handle
      assign qty = qty | plus: item.quantity
      assign last_variant_id = item.variant.id
      assign last_bundle = item.properties['_bundle'] | default: ''
      assign unit_price = item.variant.price
    endif
  endfor

  assign current_title = ''
  if qty >= 4
    assign current_title = 'BUY 2 GET 2 FREE'
  elsif qty >= 2
    assign current_title = 'BUY 1 GET 1 FREE'
  endif

  assign next_qty = 0
  if qty > 0 and qty < 2
    assign next_qty = 2
    assign next_percent = 50.02
    assign next_title = 'BUY 1 GET 1 FREE'
  elsif qty >= 2 and qty < 4
    assign next_qty = 4
    assign next_percent = 70.02
    assign next_title = 'BUY 2 GET 2 FREE'
  elsif qty >= 4 and qty < 6
    assign next_qty = 6
    assign next_percent = 75.42
    assign next_title = 'BUY 3 GET 3 FREE'
  endif
-%}

{%- if next_qty > 0 and last_variant_id != blank -%}
  {%- liquid
    assign missing = next_qty | minus: qty
    assign unit_discount = unit_price | times: next_percent | divided_by: 100.0 | floor
    assign next_each = unit_price | minus: unit_discount
    assign next_total = next_each | times: next_qty
    assign extra = next_total | minus: cart.total_price
    assign now_each = cart.total_price | divided_by: qty
    assign progress = qty | times: 100 | divided_by: next_qty
  -%}
  <div class="sbcu" data-sbcu>
    {%- if current_title != '' -%}
      <p class="sbcu-applied"><span aria-hidden="true">&#10003;</span> {{ current_title }} applied</p>
    {%- endif -%}
    <div class="sbcu-top">
      <span class="sbcu-gift" aria-hidden="true">🎁</span>
      <div>
        <p class="sbcu-kicker">Upgrade your deal</p>
        <p class="sbcu-title">Unlock <strong>{{ next_title }}</strong></p>
      </div>
    </div>
    <div class="sbcu-bar" role="progressbar" aria-valuemin="0" aria-valuemax="{{ next_qty }}" aria-valuenow="{{ qty }}" aria-label="{{ qty }} of {{ next_qty }} briefs">
      <span style="--sbcu-progress: {{ progress }}%;"></span>
    </div>
    <p class="sbcu-text">
      You're <strong>{{ missing }} {% if missing == 1 %}brief{% else %}briefs{% endif %}</strong> away. Get {{ next_qty }} for <strong>{{ next_total | money }}</strong>
      {%- if extra > 0 %}, just <strong class="sbcu-extra">{{ extra | money }}</strong> more{% endif %}.
    </p>
    <p class="sbcu-each">
      {%- if now_each > next_each -%}<s>{{ now_each | money }}</s> {% endif -%}
      <strong>{{ next_each | money }}</strong> per brief
    </p>
    <button type="button" class="sbcu-btn" data-sbcu-add data-variant="{{ last_variant_id }}" data-qty="{{ missing }}" data-bundle="{{ last_bundle | escape }}" data-unlock="{{ next_title }}" data-each="{{ next_each | money | strip_html | escape }}" data-count="{{ next_qty }}">
      <span>Yes, add {{ missing }} more</span>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h13M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </button>
    <p class="sbcu-note">Same color and size as your last brief. Want different ones? Tap Edit above.</p>
  </div>
{%- elsif qty >= 6 -%}
  <div class="sbcu sbcu--done">
    <span class="sbcu-gift" aria-hidden="true">🎉</span>
    <p class="sbcu-title">You unlocked our <strong>best deal</strong>, BUY 3 GET 3 FREE.</p>
  </div>
{%- endif -%}

<style>
  .sbcu { position: relative; overflow: hidden; margin: 0 0 14px; padding: 14px; border: 1.5px dashed #E0322B; border-radius: 14px; background: #FFF6F6; display: grid; gap: 8px; font-family: var(--font-body--family); animation: sbcu-in .45s cubic-bezier(.2, 1.2, .4, 1); }
  @keyframes sbcu-in { from { opacity: 0; transform: translateY(10px) scale(.98); } to { opacity: 1; transform: none; } }
  .sbcu-top { display: flex; align-items: center; gap: 12px; }
  .sbcu-gift { font-size: 30px; line-height: 1; }
  .sbcu-kicker { margin: 0; font-size: 11px; font-weight: 800; letter-spacing: .14em; text-transform: uppercase; color: #E0322B; }
  .sbcu-title { margin: 0; font-size: 16px; font-weight: 700; color: #1A1A1A; }
  .sbcu-title strong { color: #E0322B; font-weight: 900; }
  .sbcu-bar { height: 8px; border-radius: 999px; background: #F6DADA; overflow: hidden; }
  .sbcu-bar span { display: block; height: 100%; width: var(--sbcu-progress); border-radius: inherit; background: linear-gradient(90deg, #E0322B, #F25A4C); animation: sbcu-fill .9s ease-out; }
  @keyframes sbcu-fill { from { width: 0; } }
  .sbcu-text { margin: 0; font-size: 14px; color: #3A2C33; line-height: 1.5; }
  .sbcu-extra { color: #0B7F52; }
  .sbcu-each { margin: 0; font-size: 13px; color: #4A3B42; }
  .sbcu-each s { color: #8A7A82; margin-right: 2px; }
  .sbcu-each strong { color: #0B7F52; font-size: 15px; }
  .sbcu-btn { justify-self: center; display: inline-flex; align-items: center; justify-content: center; gap: 6px; padding: 7px 16px; border: 1.5px solid #E0322B; border-radius: 999px; background: #fff; color: #D42A22; font: inherit; font-size: 14px; font-weight: 700; letter-spacing: .01em; cursor: pointer; transition: background .2s; }
  .sbcu-btn svg { width: 15px; height: 15px; transition: transform .2s; }
  .sbcu-btn:hover { background: #FFF0F0; }
  .sbcu-btn:hover svg { transform: translateX(3px); }
  .sbcu-btn[disabled] { opacity: .7; cursor: wait; }
  .sbcu-applied { justify-self: start; margin: 0; padding: 4px 10px; border-radius: 999px; background: #E6F6EE; color: #0B7F52; font-size: 12px; font-weight: 800; letter-spacing: .02em; }
  .sbcu-note { margin: 0; font-size: 11.5px; color: #6F5F66; }
  .sbcu--done { border-style: solid; grid-template-columns: auto 1fr; align-items: center; gap: 12px; border-color: #0B7F52; background: linear-gradient(135deg, #E6F6EE, #FFF4D6); }
  .sbcu--done .sbcu-title strong { color: #0B7F52; }
  @media (prefers-reduced-motion: reduce) { .sbcu, .sbcu *, .sbcu::after { animation: none !important; } }
</style>
