{%- doc -%}
  Suggests the next Sculpt Brief bundle in the cart and adds the missing items in one tap.
  Tier sizes and percentages must match the automatic discounts in Shopify.
{%- enddoc -%}
{%- liquid
  assign handle = 'sculpt-brief'
  assign qty = 0
  assign last_variant_id = blank
  assign last_bundle = ''
  for item in cart.items
    if item.product.handle == handle
      assign qty = qty | plus: item.quantity
      assign last_variant_id = item.variant.id
      assign last_bundle = item.properties['_bundle'] | default: ''
      assign unit_price = item.variant.price
    endif
  endfor

  assign next_qty = 0
  if qty > 0 and qty < 2
    assign next_qty = 2
    assign next_percent = 50.02
    assign next_title = 'BUY 1 GET 1 FREE'
  elsif qty >= 2 and qty < 4
    assign next_qty = 4
    assign next_percent = 70.02
    assign next_title = 'BUY 2 GET 2 FREE'
  elsif qty >= 4 and qty < 6
    assign next_qty = 6
    assign next_percent = 75.42
    assign next_title = 'BUY 3 GET 3 FREE'
  endif
-%}

{%- if next_qty > 0 and last_variant_id != blank -%}
  {%- liquid
    assign missing = next_qty | minus: qty
    assign unit_discount = unit_price | times: next_percent | divided_by: 100.0 | floor
    assign next_each = unit_price | minus: unit_discount
    assign next_total = next_each | times: next_qty
    assign extra = next_total | minus: cart.total_price
    assign now_each = cart.total_price | divided_by: qty
    assign progress = qty | times: 100 | divided_by: next_qty
  -%}
  <div class="sbcu" data-sbcu>
    <div class="sbcu-top">
      <span class="sbcu-gift" aria-hidden="true">🎁</span>
      <div>
        <p class="sbcu-kicker">Upgrade your deal</p>
        <p class="sbcu-title">Unlock <strong>{{ next_title }}</strong></p>
      </div>
    </div>
    <div class="sbcu-bar" role="progressbar" aria-valuemin="0" aria-valuemax="{{ next_qty }}" aria-valuenow="{{ qty }}" aria-label="{{ qty }} of {{ next_qty }} briefs">
      <span style="--sbcu-progress: {{ progress }}%;"></span>
    </div>
    <p class="sbcu-text">
      You're <strong>{{ missing }} {% if missing == 1 %}brief{% else %}briefs{% endif %}</strong> away. Get {{ next_qty }} for <strong>{{ next_total | money }}</strong>
      {%- if extra > 0 %}, just <strong class="sbcu-extra">{{ extra | money }}</strong> more{% endif %}.
    </p>
    <p class="sbcu-each">
      {%- if now_each > next_each -%}<s>{{ now_each | money }}</s> {% endif -%}
      <strong>{{ next_each | money }}</strong> per brief
    </p>
    <button type="button" class="sbcu-btn" data-sbcu-add data-variant="{{ last_variant_id }}" data-qty="{{ missing }}" data-bundle="{{ last_bundle | escape }}">
      <span>Yes, add {{ missing }} more</span>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h13M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </button>
    <p class="sbcu-note">Same color and size as your last brief. Want different ones? Tap Edit above.</p>
  </div>
{%- elsif qty >= 6 -%}
  <div class="sbcu sbcu--done">
    <span class="sbcu-gift" aria-hidden="true">🎉</span>
    <p class="sbcu-title">You unlocked our <strong>best deal</strong>, BUY 3 GET 3 FREE.</p>
  </div>
{%- endif -%}

<style>
  .sbcu { position: relative; overflow: hidden; margin: 0 0 14px; padding: 16px; border: 2px solid #A3426D; border-radius: 16px; background: linear-gradient(135deg, #FFF4D6 0%, #FBE3EE 55%, #F6D3E3 100%); display: grid; gap: 8px; font-family: var(--font-body--family); box-shadow: 0 8px 22px rgba(163, 66, 109, .15); animation: sbcu-in .45s cubic-bezier(.2, 1.2, .4, 1); }
  .sbcu::after { content: ""; position: absolute; top: -40%; right: -20%; width: 140px; height: 140px; border-radius: 50%; background: radial-gradient(circle, rgba(255, 201, 60, .45), transparent 70%); pointer-events: none; }
  @keyframes sbcu-in { from { opacity: 0; transform: translateY(10px) scale(.98); } to { opacity: 1; transform: none; } }
  .sbcu-top { display: flex; align-items: center; gap: 12px; }
  .sbcu-gift { font-size: 30px; line-height: 1; animation: sbcu-wiggle 2.4s ease-in-out infinite; transform-origin: 50% 80%; }
  @keyframes sbcu-wiggle { 0%, 70%, 100% { transform: rotate(0); } 75% { transform: rotate(-12deg) scale(1.1); } 82% { transform: rotate(10deg) scale(1.1); } 89% { transform: rotate(-6deg); } }
  .sbcu-kicker { margin: 0; font-size: 11px; font-weight: 800; letter-spacing: .14em; text-transform: uppercase; color: #A3426D; }
  .sbcu-title { margin: 0; font-size: 16px; font-weight: 700; color: #1A1A1A; }
  .sbcu-title strong { color: #A3426D; font-weight: 900; }
  .sbcu-bar { height: 10px; border-radius: 999px; background: rgba(255, 255, 255, .8); overflow: hidden; box-shadow: inset 0 1px 2px rgba(0, 0, 0, .08); }
  .sbcu-bar span { display: block; height: 100%; width: var(--sbcu-progress); border-radius: inherit; background: repeating-linear-gradient(45deg, #A3426D 0 10px, #C2557F 10px 20px); background-size: 28px 28px; animation: sbcu-fill .9s ease-out, sbcu-stripes 1s linear infinite; }
  @keyframes sbcu-fill { from { width: 0; } }
  @keyframes sbcu-stripes { to { background-position: 28px 0; } }
  .sbcu-text { margin: 0; font-size: 14px; color: #3A2C33; line-height: 1.5; }
  .sbcu-extra { color: #0B7F52; }
  .sbcu-each { margin: 0; font-size: 13px; color: #4A3B42; }
  .sbcu-each s { color: #8A7A82; margin-right: 2px; }
  .sbcu-each strong { color: #0B7F52; font-size: 15px; }
  .sbcu-btn { position: relative; display: flex; align-items: center; justify-content: center; gap: 8px; width: 100%; padding: 14px 16px; border: 0; border-radius: 12px; background: #A3426D; color: #fff; font: inherit; font-size: 15.5px; font-weight: 800; letter-spacing: .02em; cursor: pointer; box-shadow: 0 6px 16px rgba(163, 66, 109, .35); transition: transform .15s, background .2s; animation: sbcu-pulse 2.4s ease-in-out infinite; }
  .sbcu-btn svg { width: 18px; height: 18px; transition: transform .2s; }
  .sbcu-btn:hover { background: #8A3459; transform: translateY(-1px); }
  .sbcu-btn:hover svg { transform: translateX(4px); }
  .sbcu-btn[disabled] { opacity: .7; cursor: wait; animation: none; }
  @keyframes sbcu-pulse { 0%, 100% { box-shadow: 0 6px 16px rgba(163, 66, 109, .35), 0 0 0 0 rgba(163, 66, 109, .35); } 50% { box-shadow: 0 6px 16px rgba(163, 66, 109, .35), 0 0 0 7px rgba(163, 66, 109, 0); } }
  .sbcu-note { margin: 0; font-size: 11.5px; color: #6F5F66; }
  .sbcu--done { grid-template-columns: auto 1fr; align-items: center; gap: 12px; border-color: #0B7F52; background: linear-gradient(135deg, #E6F6EE, #FFF4D6); }
  .sbcu--done .sbcu-title strong { color: #0B7F52; }
  @media (prefers-reduced-motion: reduce) { .sbcu, .sbcu *, .sbcu::after { animation: none !important; } }
</style>
